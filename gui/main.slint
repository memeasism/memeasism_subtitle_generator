import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import "fonts/impact.ttf";
component button inherits Rectangle {
    in property <string> text;
    in property <bool> checkable: false;
    in-out property <bool> checked: false;
    in-out property <bool> enabled: true;
    in property <color> background_color: #686868;
    in property <color> checked_background_color: #e53b44;
    in property <color> pressed_color: #494949;
    in property <color> hover_color: #181425;
    in property <color> text_color: #ffffff;
    in property <color> stroke: #000000;
    in property <length> font_size: 0.075 * root.width;
    in property <length> radius: 0.5rem;
    callback clicked;
    background: {
        if (!root.enabled) { return #000000; }
        if (root.checked) { return root.checked_background_color; }
        if (touch.pressed) { return root.pressed_color; }
        if (touch.has-hover) { return root.hover_color; }
        return root.background_color;
    }
    border-radius: root.radius;
    Text {
        text: root.text;
        color: root.text_color;
        stroke: root.stroke;
        font-size: root.font_size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.checkable) {
                root.checked = !root.checked;
            }
            root.clicked();
        }
    }
}

component text_box {
    callback inputs_changed();
    in-out property <string> text_content;
    in-out property <string> length_content: "00:00:00:00";
    in-out property <string> fps_content: "60.00";
    in-out property <string> word_delay: "10";
    in-out property <bool> word_by_word: true;
    VerticalBox {
        width: 100%;
        height: 100%;
        Text {
            text: "Insert Text Here";
            font-size: 0.05 * root.width;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: #ffffff;
            stroke: #000000;
        }

        Rectangle {
            background: #c0c0c0;
            TextInput {
                text <=> root.text_content;
                edited => { root.inputs_changed(); }
                font-size: 0.025 * root.width;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: #000000;
                single-line: false;
                wrap: word-wrap;
            }
        }

        HorizontalBox {
            vertical-stretch: 0;
            VerticalBox {
                Text {
                    text: "Length";
                    font-size: 0.025 * root.width;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: #ffffff;
                    stroke: #000000;
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #c0c0c0;
                    TextInput {
                        text <=> root.length_content;
                        edited => { root.inputs_changed(); }
                        font-size: 0.025 * root.width;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: #000000;
                    }
                }
            }

            VerticalBox {
                Text {
                    text: "FPS";
                    font-size: 0.025 * root.width;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: #ffffff;
                    stroke: #000000;
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #c0c0c0;
                    TextInput {
                        text <=> root.fps_content;
                        edited => { root.inputs_changed(); }
                        font-size: 0.025 * root.width;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        color: #000000;
                    }
                }
            }

            if root.word_by_word: VerticalBox {
                Text {
                    text: "Word Delay";
                    font-size: 0.025 * root.width;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: #ffffff;
                    stroke: #000000;
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #c0c0c0;
                    TextInput {
                        text <=> root.word_delay;
                        edited => { root.inputs_changed(); }
                        font-size: 0.025 * root.width;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        color: #000000;
                    }
                }
            }
        }
    }
}

component buttons {
    in-out property <string> output_text;
    in-out property <bool> word_by_word: true;
    in-out property <bool> pop_out: false;
    callback copy_subtitle();
    callback inputs_changed();
    VerticalBox {
        width: 100%;
        height: 100%;
        Text {
            text: "Toggles:";
            font-size: 0.075 * root.width;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: #ffffff;
            stroke: #000000;
        }

        button {
            vertical-stretch: 0;
            text: "Word By Word";
            checkable: true;
            checked <=> root.word_by_word;
            clicked => { root.inputs_changed(); }
        }

        button {
            vertical-stretch: 0;
            text: "Pop Out";
            checkable: true;
            checked <=> root.pop_out;
            clicked => { root.inputs_changed(); }
        }

        Text {
            text: "Output:";
            font-size: 0.075 * root.width;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: #ffffff;
            stroke: #000000;
        }

        Rectangle {
            vertical-stretch: 0;
            width: 100%;
            height: 100%;
            clip: true;
            background: #c0c0c0;
            scroll := ScrollView {
                width: 100%;
                height: 100%;
                content-width: parent.width;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: as-needed;
                VerticalLayout {
                    alignment: start;
                    width: parent.content-width;
                    Text {
                        width: 100%;
                        height: 100%;
                        font-size: 0.05 * root.width;
                        color: #000000;
                        text: root.output_text;
                        wrap: word-wrap;
                    }
                }
            }
        }

        button {
            vertical-stretch: 0;
            text: "Copy Subtitle";
            clicked => { root.copy_subtitle() }
        }
    }
}

export component GUI inherits Window {
    in-out property <string> text_content;
    in-out property <string> length_content: "00:00:00:00";
    in-out property <string> fps_content: "60.00";
    in-out property <string> word_delay: "10";
    in-out property <string> output_text;
    in-out property <bool> word_by_word: true;
    in-out property <bool> pop_out: false;
    callback copy_subtitle();
    callback inputs_changed();
    title: "Memeaism Subtitle Generator";
    icon: @image-url("../icons/icon.ico");
    background: #282828;
    preferred-width: 640px;
    preferred-height: 480px;
    default-font-family: "Impact";
    //min-width: self.preferred-width;
    //min-height: self.preferred-height;
    text_box {
        width: 75%;
        height: 75%;
        x: 0;
        text_content <=> root.text_content;
        length_content <=> root.length_content;
        fps_content <=> root.fps_content;
        word_delay <=> root.word_delay;
        word_by_word <=> root.word_by_word;
        inputs_changed => { root.inputs_changed(); }
    }

    buttons {
        width: 25%;
        height: 50%;
        x: parent.width - self.width;
        y: (parent.height - self.height) / 3;
        output-text <=> root.output-text;
        word_by_word <=> root.word_by_word;
        pop_out <=> root.pop_out;
        copy_subtitle => { root.copy_subtitle(); }
        inputs_changed => { root.inputs_changed(); }
    }
}
