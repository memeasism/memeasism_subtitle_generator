import { ScrollView } from "std-widgets.slint";
import "fonts/impact.ttf";
global THEME { //just colors set as variables basically, makes it easier to read and use imo, based off of my profile picture.
    out property <color> white: #ffffff;
    out property <color> black: #000000;
    out property <color> light_grey: #c0c0c0;
    out property <color> grey: #686868;
    out property <color> medium_grey: #494949;
    out property <color> dark_grey: #282828;
    out property <color> coal: #181425;
    out property <color> red:#e53b44;
}

component vertical_input inherits VerticalLayout { //input box with text above it, defined here so it's less code overall
    in property <length> font_size: 2rem;
    in property <length> input_font_size: 2rem;
    in property <color> background_color: THEME.light_grey;
    in property <color> text_color: THEME.white;
    in property <color> text_stroke: THEME.black;
    in property <color> input_text_color: THEME.black;
    in property <string> text: "Text";
    in-out property <string> input_text: "";
    callback edited();
    Text {
        text: root.text;
        font-size: root.font_size;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.text_color;
        stroke: root.text_stroke;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.background_color;
        TextInput {
            text <=> root.input_text;
            edited => { root.edited(); }
            font-size: root.input_font_size;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: root.input_text_color;
            single-line: false;
            wrap: word-wrap;
        }
    }
}

component button inherits Rectangle { //custom button, the one build into slint lacks customization
    in property <string> text;
    in property <bool> checkable: false;
    in-out property <bool> checked: false;
    in property <color> background_color: THEME.grey;
    in property <color> checked_background_color: THEME.red;
    in property <color> pressed_color: THEME.medium_grey;
    in property <color> hover_color: THEME.coal;
    in property <color> text_color: THEME.white;
    in property <color> stroke: THEME.black;
    in property <length> font_size: 2rem;
    in property <length> radius: 1rem;
    callback clicked;
    vertical-stretch: 0;
    background: {
        if (root.checked) { return root.checked_background_color; }
        if (touch.pressed) { return root.pressed_color; }
        if (touch.has-hover) { return root.hover_color; }
        return root.background_color;
    }
    border-radius: root.radius;
    Text {
        text: root.text;
        color: root.text_color;
        stroke: root.stroke;
        font-size: root.font_size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            if (root.checkable) {
                root.checked = !root.checked;
            }
            root.clicked();
        }
    }
}

component inputs { // the input boxes formatted, and with variables to look good
    callback inputs_changed();
    in-out property <string> text_content;
    in-out property <string> length_content: "00:00:00:00";
    in-out property <string> fps_content: "60.00";
    in-out property <string> word_delay: "10";
    in-out property <bool> word_by_word: true;
    VerticalLayout {
        spacing: 4rem;
        width: 100%;
        height: 100%;
        vertical_input {
            text: "Subtitle Text";
            input_text <=> root.text_content;
            input_font_size: 1rem;
            edited => { root.inputs_changed(); }
        }

        HorizontalLayout {
            spacing: 2rem;
            vertical-stretch: 0;
            vertical-input {
                text: "Length";
                input_text <=> root.length_content;
                edited => { root.inputs_changed(); }
            }

            vertical-input {
                text: "FPS";
                input_text <=> root.fps_content;
                edited => { root.inputs_changed(); }
            }

            if root.word_by_word: vertical-input {
                text: "Word Delay";
                input_text <=> root.word_delay;
                edited => { root.inputs_changed(); }
            }
        }
    }
}

component buttons { //the buttons formatted, and with variables to look good
    in-out property <string> output_text;
    in-out property <bool> word_by_word: true;
    in-out property <bool> pop_out: false;
    callback copy_subtitle();
    callback inputs_changed();
    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 1rem;
        Text {
            text: "Toggles:";
            font-size: 2rem;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: THEME.white;
            stroke: THEME.black;
        }

        button {
            text: "Word By Word";
            checkable: true;
            checked <=> root.word_by_word;
            clicked => { root.inputs_changed(); }
        }

        button {
            text: "Pop Out";
            checkable: true;
            checked <=> root.pop_out;
            clicked => { root.inputs_changed(); }
        }

        Text {
            text: "Output:";
            font-size: 2rem;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: THEME.white;
            stroke: THEME.black;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            clip: true;
            background: THEME.light_grey;
            ScrollView {
                width: 100%;
                height: 100%;
                content-width: parent.width;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: as-needed;
                VerticalLayout {
                    alignment: start;
                    width: parent.content-width;
                    Text {
                        width: 100%;
                        height: 100%;
                        font-size: 1rem;
                        color: THEME.black;
                        text: root.output_text;
                        wrap: word-wrap;
                    }
                }
            }
        }

        button {
            text: "Copy Subtitle";
            clicked => { root.copy_subtitle() }
        }
    }
}

export component GUI inherits Window {
    in-out property <string> text_content;
    in-out property <string> length_content: "00:00:00:00";
    in-out property <string> fps_content: "60.00";
    in-out property <string> word_delay: "10";
    in-out property <string> output_text;
    in-out property <bool> word_by_word: true;
    in-out property <bool> pop_out: false;
    callback copy_subtitle();
    callback inputs_changed();
    title: "Memeaism Subtitle Generator";
    icon: @image-url("../icons/icon.ico");
    background: THEME.dark_grey;
    preferred-width: 640px;
    preferred-height: 480px;
    min-height: 240px;
    min-width: 240px;
    default-font-size: min(self.width / 80, self.height / 60);
    //dynamic default font size, prevents issues, and allows rem to work, which is cleaner for the code
    default-font-family: "Impact";
    HorizontalLayout { //layout the inputs and buttons horizontally
        y: parent.height / 10; //center vertically
        width: 95%;
        height: 100%;
        spacing: 1rem;
        inputs {
            width: 75%;
            height: 75%;
            text_content <=> root.text_content;
            length_content <=> root.length_content;
            fps_content <=> root.fps_content;
            word_delay <=> root.word_delay;
            word_by_word <=> root.word_by_word;
            inputs_changed => { root.inputs_changed(); }
        }

        buttons {
            y: parent.y * 2; //center vertically
            width: 25%;
            height: 25%;
            output-text <=> root.output-text;
            word_by_word <=> root.word_by_word;
            pop_out <=> root.pop_out;
            copy_subtitle => { root.copy_subtitle(); }
            inputs_changed => { root.inputs_changed(); }
        }
    }
}
